# Copie para backend/.env e preencha. Nunca faça commit do .env.

# Banco PostgreSQL: local (docker compose up -d db) ou Neon
DATABASE_URL=postgresql://keepit:keepit@localhost:5432/keepit

# Porta da API
PORT=3333

# Origem do front-end liberada no CORS
CORS_ORIGIN=http://localhost:5173

# Segredo para assinar o JWT (gere um com: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA_EM=7d

# Chave que o workflow agendado usa para chamar POST /internal/jobs
JOBS_KEY=troque-por-outra-chave

# Armazenamento de fotos (S3 compatível, ex.: Cloudflare R2) — usado pelo M3
S3_ENDPOINT=
S3_REGIAO=auto
S3_BUCKET=keepit-fotos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mail transacional (Resend) — usado pelo M1, M2 e M5
RESEND_API_KEY=
EMAIL_REMETENTE=KeepIT <nao-responda@keepit.app>
