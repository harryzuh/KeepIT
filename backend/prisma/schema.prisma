// KeepIT — modelo de dados (gera as tabelas do Diagrama ER no PostgreSQL)
// Fonte: Diagrama de Classes v3 e Diagrama ER da documentação.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// A URL do banco fica em prisma.config.ts (lida de DATABASE_URL).
datasource db {
  provider = "postgresql"
}

enum NomePlano {
  INDIVIDUAL
  FAMILIA
  BUSINESS
}

enum Papel {
  ADMIN
  EDITOR
  LEITOR
}

enum StatusAssinatura {
  PENDENTE
  ATIVA
  CANCELADA
  EXPIRADA
}

enum FinalidadeCodigo {
  RECUPERAR_SENHA
  ALTERAR_EMAIL
}

model Usuario {
  id                   Int       @id @default(autoincrement())
  nome                 String    @db.VarChar(80)
  email                String    @unique @db.VarChar(120)
  senhaHash            String    @map("senha_hash")
  criadoEm             DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  exclusaoSolicitadaEm DateTime? @map("exclusao_solicitada_em") @db.Timestamptz

  membro              Membro?
  assinaturas         Assinatura[]        @relation("Titular")
  produtosAdicionados Produto[]           @relation("AdicionadoPor")
  codigos             CodigoVerificacao[]
  logs                LogAuditoria[]

  @@map("usuario")
}

model Casa {
  id       Int      @id @default(autoincrement())
  nome     String   @db.VarChar(80)
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz

  membros     Membro[]
  produtos    Produto[]
  tags        Tag[]
  assinaturas Assinatura[]
  logs        LogAuditoria[]

  @@map("casa")
}

/// Cada usuário participa de exatamente uma Casa por vez (usuario_id é único).
model Membro {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @unique @map("usuario_id")
  casaId    Int      @map("casa_id")
  papel     Papel
  entrouEm  DateTime @default(now()) @map("entrou_em") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  casa    Casa    @relation(fields: [casaId], references: [id], onDelete: Cascade)

  @@index([casaId])
  @@map("membro")
}

model Plano {
  id                    Int       @id @default(autoincrement())
  nome                  NomePlano @unique
  preco                 Decimal   @db.Decimal(10, 2)
  limiteMembros         Int       @map("limite_membros")
  limiteArmazenamentoGb Int       @map("limite_armazenamento_gb")

  assinaturas Assinatura[]

  @@map("plano")
}

/// Regra extra criada por migration SQL: no máximo uma assinatura ATIVA ou CANCELADA vigente por Casa
/// (índice único parcial em casa_id WHERE status IN ('ATIVA','CANCELADA')).
model Assinatura {
  id               Int              @id @default(autoincrement())
  casaId           Int              @map("casa_id")
  planoId          Int              @map("plano_id")
  titularId        Int              @map("titular_id")
  status           StatusAssinatura @default(PENDENTE)
  dataInicio       DateTime         @default(now()) @map("data_inicio") @db.Timestamptz
  dataRenovacao    DateTime         @map("data_renovacao") @db.Timestamptz
  dataCancelamento DateTime?        @map("data_cancelamento") @db.Timestamptz
  refPagamento     String?          @map("ref_pagamento")

  casa    Casa    @relation(fields: [casaId], references: [id], onDelete: Cascade)
  plano   Plano   @relation(fields: [planoId], references: [id])
  titular Usuario @relation("Titular", fields: [titularId], references: [id])

  @@index([casaId, status])
  @@map("assinatura")
}

model Produto {
  id              Int      @id @default(autoincrement())
  casaId          Int      @map("casa_id")
  adicionadoPorId Int?     @map("adicionado_por_id")
  nome            String   @db.VarChar(120)
  descricao       String?
  preco           Decimal  @db.Decimal(12, 2)
  quantidade      Int      @default(1)
  dataCompra      DateTime @map("data_compra") @db.Date
  dataCadastro    DateTime @default(now()) @map("data_cadastro") @db.Timestamptz

  casa          Casa         @relation(fields: [casaId], references: [id], onDelete: Cascade)
  adicionadoPor Usuario?     @relation("AdicionadoPor", fields: [adicionadoPorId], references: [id], onDelete: SetNull)
  fotos         Foto[]
  tags          ProdutoTag[]

  /// A busca e a verificação de duplicado usam lower(nome); o índice funcional é criado por migration SQL.
  @@index([casaId, nome])
  @@map("produto")
}

/// Até 3 fotos por produto (validado na API).
model Foto {
  id           Int    @id @default(autoincrement())
  produtoId    Int    @map("produto_id")
  url          String
  tamanhoBytes Int    @map("tamanho_bytes")
  ordem        Int    @db.SmallInt

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId])
  @@map("foto")
}

model Tag {
  id     Int    @id @default(autoincrement())
  casaId Int    @map("casa_id")
  nome   String @db.VarChar(40)

  casa     Casa         @relation(fields: [casaId], references: [id], onDelete: Cascade)
  produtos ProdutoTag[]

  @@unique([casaId, nome])
  @@map("tag")
}

model ProdutoTag {
  produtoId Int @map("produto_id")
  tagId     Int @map("tag_id")

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([produtoId, tagId])
  @@map("produto_tag")
}

model CodigoVerificacao {
  id         Int              @id @default(autoincrement())
  usuarioId  Int              @map("usuario_id")
  codigoHash String           @map("codigo_hash")
  finalidade FinalidadeCodigo
  expiraEm   DateTime         @map("expira_em") @db.Timestamptz
  usadoEm    DateTime?        @map("usado_em") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("codigo_verificacao")
}

/// RNF05: registro de alterações de plano, assinatura, cancelamento e exclusão de produtos.
model LogAuditoria {
  id         BigInt   @id @default(autoincrement())
  usuarioId  Int?     @map("usuario_id")
  casaId     Int?     @map("casa_id")
  acao       String
  entidade   String
  entidadeId Int      @map("entidade_id")
  detalhes   Json?
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  casa    Casa?    @relation(fields: [casaId], references: [id], onDelete: SetNull)

  @@index([casaId, criadoEm])
  @@map("log_auditoria")
}
