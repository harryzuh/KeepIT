Width=1.5;fillColor=#ffffff;strokeColor=#6B716F;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="30" y="894" width="46" height="26" as="geometry"/></mxCell><mxCell id="ltm" value="Contorno tracejado = modal (abre sobre a tela de origem)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="88" y="898" width="420" height="22" as="geometry"/></mxCell><mxCell id="nt" value="Numeração = número da tela no protótipo do Figma. A tela 08 é usada para adicionar e para editar produto. Se um EDITOR ou LEITOR assinar um plano, a tela 24 avisa que ele sai da Casa atual e vira ADMIN de uma Casa nova (cada usuário participa de uma Casa por vez). O LEITOR vê as telas de produto, mas sem os botões de adicionar, editar e excluir." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="940" width="470" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>