<mxfile host="app.diagrams.net"><diagram id="p0" name="Macroprocesso"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="KeepIT — Macroprocesso (cadeia de valor)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="900" height="30" as="geometry"/></mxCell><mxCell id="g" value="Processos de gestão" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#E1ECF6;strokeColor=#2C5D8A;fontColor=#2C5D8A;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="1300" height="100" as="geometry"/></mxCell><mxCell id="g0" value="Planejar o produto&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10.5px&quot;&gt;roadmap, backlog e prioridades&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fillColor=#ffffff;strokeColor=#2C5D8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220.0" y="95" width="406.6666666666667" height="52" as="geometry"/></mxCell><mxCell id="g1" value="Acompanhar indicadores&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10.5px&quot;&gt;usuários ativos, conversão para plano pago, cancelamentos&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fillColor=#ffffff;strokeColor=#2C5D8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="646.6666666666667" y="95" width="406.6666666666667" height="52" as="geometry"/></mxCell><mxCell id="g2" value="Garantir conformidade&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10.5px&quot;&gt;LGPD, termos de uso e auditoria (logs)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fillColor=#ffffff;strokeColor=#2C5D8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1073.3333333333335" y="95" width="406.6666666666667" height="52" as="geometry"/></mxCell><mxCell id="m" value="Processos principais" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#F3F8F6;strokeColor=#0F5C4D;fontColor=#0F5C4D;" vertex="1" parent="1"><mxGeometry x="200" y="180" width="1300" height="315" as="geometry"/></mxCell><mxCell id="s0" value="1. Captar e cadastrar" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=26;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3EFEB;strokeColor=#0F5C4D;strokeWidth=1.5;fontSize=12.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220.0" y="215" width="231.66666666666666" height="62" as="geometry"/></mxCell><mxCell id="d0" value="• Visitante conhece o app&lt;br&gt;• Cria a conta (RF02)&lt;br&gt;• Casa criada com plano Individual (RF32)&lt;br&gt;• Login e recuperação de senha&lt;br&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#9DBFB5;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="234.0" y="295" width="191.66666666666666" height="125" as="geometry"/></mxCell><mxCell id="s1" value="2. Configurar a Casa" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=26;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3EFEB;strokeColor=#0F5C4D;strokeWidth=1.5;fontSize=12.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="425.66666666666663" y="215" width="231.66666666666666" height="62" as="geometry"/></mxCell><mxCell id="d1" value="• Convidar membros (RF26)&lt;br&gt;• Definir papéis ADMIN, EDITOR e LEITOR&lt;br&gt;• Respeitar o limite do plano&lt;br&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#9DBFB5;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="439.66666666666663" y="295" width="191.66666666666666" height="125" as="geometry"/></mxCell><mxCell id="s2" value="3. Inventariar os bens" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=26;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#0F5C4D;strokeColor=#0F5C4D;fontColor=#ffffff;strokeWidth=1.5;fontSize=12.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="631.3333333333333" y="215" width="231.66666666666666" height="62" as="geometry"/></mxCell><mxCell id="d2" value="• Fotografar e cadastrar produtos (RF03)&lt;br&gt;• Aplicar tags (RF35)&lt;br&gt;• Tratar duplicados (RF33)&lt;br&gt;• Editar e excluir&lt;br&gt;• BPMN Processo 1&lt;br&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#9DBFB5;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="645.3333333333333" y="295" width="191.66666666666666" height="125" as="geometry"/></mxCell><mxCell id="s3" value="4. Acompanhar o patrimônio" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=26;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3EFEB;strokeColor=#0F5C4D;strokeWidth=1.5;fontSize=12.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="837.0" y="215" width="231.66666666666666" height="62" as="geometry"/></mxCell><mxCell id="d3" value="• Consultar e buscar produtos (RF34)&lt;br&gt;• Ver valor total e estatísticas (RF23, RF24)&lt;br&gt;• Ver quem adicionou e quando&lt;br&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#9DBFB5;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="851.0" y="295" width="191.66666666666666" height="125" as="geometry"/></mxCell><mxCell id="s4" value="5. Monetizar" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=26;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#0F5C4D;strokeColor=#0F5C4D;fontColor=#ffffff;strokeWidth=1.5;fontSize=12.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1042.6666666666665" y="215" width="231.66666666666666" height="62" as="geometry"/></mxCell><mxCell id="d4" value="• Contratar ou trocar plano (RF13)&lt;br&gt;• Pagamento e renovação mensal&lt;br&gt;• Membro que assina cria Casa nova (RF38)&lt;br&gt;• BPMN Processo 2&lt;br&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#9DBFB5;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1056.6666666666665" y="295" width="191.66666666666666" height="125" as="geometry"/></mxCell><mxCell id="s5" value="6. Reter ou encerrar" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=26;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3EFEB;strokeColor=#0F5C4D;strokeWidth=1.5;fontSize=12.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1248.3333333333333" y="215" width="231.66666666666666" height="62" as="geometry"/></mxCell><mxCell id="d5" value="• Cancelar assinatura (RF16)&lt;br&gt;• Expirar e voltar ao Individual (RF37)&lt;br&gt;• Excluir conta em até 24 h (RF20)&lt;br&gt;• BPMN Processo 3&lt;br&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#9DBFB5;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1262.3333333333333" y="295" width="191.66666666666666" height="125" as="geometry"/></mxCell><mxCell id="loop" value="↺ Ciclo contínuo: o usuário volta às etapas 3 e 4 sempre que compra, vende ou reorganiza seus bens; a etapa 5 se repete a cada renovação mensal." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="220" y="432" width="1260" height="30" as="geometry"/></mxCell><mxCell id="dest" value="Etapas em destaque (3 e 5) são o núcleo de valor: o inventário com fotos é o que o usuário busca, e a assinatura é a receita do produto." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="220" y="458" width="1260" height="30" as="geometry"/></mxCell><mxCell id="a" value="Processos de apoio" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#FBF0DC;strokeColor=#C98A1B;fontColor=#7A4E0E;" vertex="1" parent="1"><mxGeometry x="200" y="515" width="1300" height="110" as="geometry"/></mxCell><mxCell id="a0" value="Suporte ao usuário&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10.5px&quot;&gt;contato com a equipe (RF29)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fillColor=#ffffff;strokeColor=#C98A1B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220.0" y="550" width="239.2" height="60" as="geometry"/></mxCell><mxCell id="a1" value="Segurança e acesso&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10.5px&quot;&gt;login, papéis, senhas (RNF01, RNF31)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fillColor=#ffffff;strokeColor=#C98A1B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="475.2" y="550" width="239.2" height="60" as="geometry"/></mxCell><mxCell id="a2" value="Infraestrutura e dados&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10.5px&quot;&gt;hospedagem, fotos, backup (RNF23)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fillColor=#ffffff;strokeColor=#C98A1B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730.4" y="550" width="239.2" height="60" as="geometry"/></mxCell><mxCell id="a3" value="Gestão de pagamentos&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10.5px&quot;&gt;gateway, cobranças e recusas&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fillColor=#ffffff;strokeColor=#C98A1B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="985.5999999999999" y="550" width="239.2" height="60" as="geometry"/></mxCell><mxCell id="a4" value="Comunicação&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10.5px&quot;&gt;e-mails de código, convite e renovação&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fillColor=#ffffff;strokeColor=#C98A1B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240.8" y="550" width="239.2" height="60" as="geometry"/></mxCell><mxCell id="in" value="&lt;b&gt;Entrada&lt;/b&gt;&lt;br&gt;Pessoa ou família que quer organizar e saber quanto valem seus bens" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="15" y="305" width="160" height="110" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;Saída&lt;/b&gt;&lt;br&gt;Patrimônio registrado, valorizado e compartilhado; receita recorrente" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="1525" y="305" width="160" height="110" as="geometry"/></mxCell><mxCell id="ei" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5714;" edge="1" parent="1" source="in" target="m"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eo" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;exitX=1;exitY=0.5714;entryX=0;entryY=0.5;" edge="1" parent="1" source="m" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>