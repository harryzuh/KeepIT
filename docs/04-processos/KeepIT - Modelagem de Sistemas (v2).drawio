 evitar cruzamentos" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1120" width="1350" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="8 - Maquina de Estados Assinatura"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="KeepIT — Máquina de Estados: Assinatura (notação UML)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="i0" value="" style="ellipse;aspect=fixed;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="297" width="26" height="26" as="geometry"/></mxCell><mxCell id="PEN" value="&lt;b&gt;PENDENTE&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;entry / solicitar cobrança ao gateway&lt;/div&gt;" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="260" width="230" height="100" as="geometry"/></mxCell><mxCell id="ATV" value="&lt;b&gt;ATIVA&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;entry / aplicar limites do plano à Casa&lt;br&gt;faça: liberar membros e armazenamento&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;do plano contratado&lt;/div&gt;" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="270" height="120" as="geometry"/></mxCell><mxCell id="CAN" value="&lt;b&gt;CANCELADA&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;entry / desligar renovação;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;e-mail com data de término&lt;br&gt;faça: manter benefícios até dataRenovacao&lt;/div&gt;" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="250" width="280" height="120" as="geometry"/></mxCell><mxCell id="EXP" value="&lt;b&gt;EXPIRADA&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;entry / Casa volta ao plano Individual;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;membros extras recebem Casa própria;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;enviar aviso de expiração&lt;/div&gt;" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="590" width="290" height="120" as="geometry"/></mxCell><mxCell id="f1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="240" y="560" width="30" height="30" as="geometry"/></mxCell><mxCell id="f2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="680" y="90" width="30" height="30" as="geometry"/></mxCell><mxCell id="f3" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1230" y="635" width="30" height="30" as="geometry"/></mxCell><mxCell id="e1" value="assinar(plano)&lt;br&gt;[qualquer papel;&lt;br&gt;membro confirmou aviso]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="i0" target="PEN"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="pagamentoAprovado&lt;br&gt;/ dataInicio = hoje;&lt;br&gt;dataRenovacao = hoje + ciclo;&lt;br&gt;[membro] criar Casa nova" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.42;" edge="1" parent="1" source="PEN" target="ATV"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="pagamentoRecusado&lt;br&gt;/ descartar e informar recusa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="PEN" target="f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="dataRenovacao atingida&lt;br&gt;[cobrança aprovada]&lt;br&gt;/ dataRenovacao += 1 ciclo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.18;exitY=1;entryX=0.52;entryY=1;" edge="1" parent="1" source="ATV" target="ATV"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="440"/><mxPoint x="700" y="440"/></Array></mxGeometry></mxCell><mxCell id="e5" value="novo plano ativado (troca de plano)&lt;br&gt;/ encerrar como substituída" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.52;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ATV" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="cancelar() [ADMIN confirmou]&lt;br&gt;/ registrar motivo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="ATV" target="CAN"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="reativar() [hoje &amp;lt; dataRenovacao]&lt;br&gt;/ religar renovação" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="CAN" target="ATV"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="dataRenovacao atingida [cobrança recusada]&lt;br&gt;ou excluirConta() do titular" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.82;exitY=1;entryX=0.24;entryY=0;" edge="1" parent="1" source="ATV" target="EXP"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="520"/><mxPoint x="870" y="520"/></Array></mxGeometry></mxCell><mxCell id="e9" value="dataRenovacao atingida&lt;br&gt;ou excluirConta() do titular" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.76;entryY=0;" edge="1" parent="1" source="CAN" target="EXP"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="520"/><mxPoint x="1020" y="520"/></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="EXP" target="f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nt" value="&lt;b&gt;Regras e escopo&lt;/b&gt;&lt;br&gt;• Modela as assinaturas pagas (Família e Business). O plano &lt;b&gt;Individual&lt;/b&gt; é gratuito e não tem assinatura: é o plano da Casa quando ela não tem assinatura vigente.&lt;br&gt;• Uma Casa tem no máximo uma assinatura ATIVA ou CANCELADA por vez; trocar de plano cria uma assinatura nova e encerra a anterior.&lt;br&gt;• Qualquer papel pode assinar. Se o titular é EDITOR ou LEITOR, com o pagamento aprovado ele sai da Casa atual e vira ADMIN de uma Casa nova (RF38).&lt;br&gt;• Ao EXPIRAR, os produtos são mantidos e novas fotos ficam bloqueadas se o armazenamento exceder o limite do Individual. Eventos de tempo (dataRenovacao atingida) são disparados pela rotina agendada do sistema." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#c9b458;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="1300" height="120" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Notação:&lt;/b&gt; ● estado inicial · ◉ estado final · ▢ estado (entry = ação ao entrar · faça: = atividade enquanto está no estado) · evento [guarda] / ação na transição" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="900" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>