<mxfile host="app.diagrams.net"><diagram id="p0" name="MVC"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="KeepIT — Padrão MVC aplicado ao sistema" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="900" height="30" as="geometry"/></mxCell><mxCell id="Lv" value="VIEW · Front-end React" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E1ECF6;strokeColor=#2C5D8A;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="360" height="880" as="geometry"/></mxCell><mxCell id="Dv" value="&lt;b&gt;Páginas&lt;/b&gt; (uma por tela do protótipo)&lt;br&gt;&lt;b&gt;Componentes&lt;/b&gt; reutilizáveis (botões, cartões, modais)&lt;br&gt;&lt;b&gt;Hooks de dados&lt;/b&gt; (TanStack Query) que chamam a API" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2C5D8A;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="45" y="100" width="330" height="80" as="geometry"/></mxCell><mxCell id="Lc" value="CONTROLLER · API Express" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3EFEB;strokeColor=#0F5C4D;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="360" height="880" as="geometry"/></mxCell><mxCell id="Dc" value="&lt;b&gt;Rotas&lt;/b&gt; (URL + método HTTP)&lt;br&gt;&lt;b&gt;Middlewares&lt;/b&gt;: autenticação, papel, validação&lt;br&gt;&lt;b&gt;Controllers&lt;/b&gt;: recebem a requisição e respondem" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#0F5C4D;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="435" y="100" width="330" height="80" as="geometry"/></mxCell><mxCell id="Lm" value="MODEL · Regras e dados" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBF0DC;strokeColor=#C98A1B;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="810" y="60" width="360" height="880" as="geometry"/></mxCell><mxCell id="Dm" value="&lt;b&gt;Services&lt;/b&gt;: regras de negócio de M1 a M5&lt;br&gt;&lt;b&gt;Prisma&lt;/b&gt;: modelos das entidades&lt;br&gt;(Usuario, Casa, Membro, Produto, Tag, Assinatura...)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#C98A1B;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="825" y="100" width="330" height="80" as="geometry"/></mxCell><mxCell id="Ld" value="BANCO · PostgreSQL" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EEEDE8;strokeColor=#5D625F;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1200" y="60" width="330" height="880" as="geometry"/></mxCell><mxCell id="Dd" value="&lt;b&gt;Tabelas&lt;/b&gt; geradas pelas migrations do Prisma" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#5D625F;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1215" y="100" width="300" height="80" as="geometry"/></mxCell><mxCell id="s1" value="Usuário preenche a tela 08 e toca em “Registrar produto”. O hook &lt;i&gt;useCriarProduto&lt;/i&gt; envia POST /produtos com o token JWT." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2C5D8A;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="75" y="230" width="300" height="66" as="geometry"/></mxCell><mxCell id="n1" value="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#1C1F1E;strokeColor=#1C1F1E;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="62" y="217" width="26" height="26" as="geometry"/></mxCell><mxCell id="s2" value="Rota &lt;i&gt;POST /produtos&lt;/i&gt;. Middlewares: token válido? Papel é ADMIN ou EDITOR? Dados válidos pelo esquema Zod?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#0F5C4D;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="465" y="306" width="300" height="66" as="geometry"/></mxCell><mxCell id="n2" value="2" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#1C1F1E;strokeColor=#1C1F1E;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="452" y="293" width="26" height="26" as="geometry"/></mxCell><mxCell id="a2" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s3" value="&lt;i&gt;produtosController.criar&lt;/i&gt; repassa os dados ao service." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#0F5C4D;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="465" y="382" width="300" height="66" as="geometry"/></mxCell><mxCell id="n3" value="3" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#1C1F1E;strokeColor=#1C1F1E;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="452" y="369" width="26" height="26" as="geometry"/></mxCell><mxCell id="a3" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s4" value="&lt;i&gt;produtosService.criar&lt;/i&gt;: confere a cota do plano da Casa e procura produto com o mesmo nome na mesma Casa." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#C98A1B;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="855" y="458" width="300" height="66" as="geometry"/></mxCell><mxCell id="n4" value="4" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#1C1F1E;strokeColor=#1C1F1E;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="842" y="445" width="26" height="26" as="geometry"/></mxCell><mxCell id="a4" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s5" value="SELECT em &lt;i&gt;produto&lt;/i&gt; (mesmo nome, mesma casa_id)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#5D625F;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1245" y="534" width="270" height="66" as="geometry"/></mxCell><mxCell id="n5" value="5" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#1C1F1E;strokeColor=#1C1F1E;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1232" y="521" width="26" height="26" as="geometry"/></mxCell><mxCell id="a5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s6" value="Se já existe e o usuário não escolheu uma opção: devolve o erro PRODUTO_DUPLICADO. Senão: grava o produto e as tags." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#C98A1B;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="855" y="610" width="300" height="66" as="geometry"/></mxCell><mxCell id="n6" value="6" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#1C1F1E;strokeColor=#1C1F1E;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="842" y="597" width="26" height="26" as="geometry"/></mxCell><mxCell id="a6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;exitX=0;exitY=0.5;entryX=1;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1215" y="567.0"/><mxPoint x="1215" y="643.0"/></Array></mxGeometry></mxCell><mxCell id="s7" value="INSERT em &lt;i&gt;produto&lt;/i&gt; e &lt;i&gt;produto_tag&lt;/i&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#5D625F;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1245" y="686" width="270" height="66" as="geometry"/></mxCell><mxCell id="n7" value="7" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#1C1F1E;strokeColor=#1C1F1E;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1232" y="673" width="26" height="26" as="geometry"/></mxCell><mxCell id="a7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;exitX=1;exitY=0.75;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="659.5"/><mxPoint x="1185" y="719.0"/></Array></mxGeometry></mxCell><mxCell id="s8" value="Responde 201 (criado) com o produto em JSON, ou 409 (conflito) com os dados do produto existente." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#0F5C4D;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="465" y="762" width="300" height="66" as="geometry"/></mxCell><mxCell id="n8" value="8" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#1C1F1E;strokeColor=#1C1F1E;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="452" y="749" width="26" height="26" as="geometry"/></mxCell><mxCell id="a8" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=1;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380.0" y="795.0"/></Array></mxGeometry></mxCell><mxCell id="s9" value="201: volta para a lista e mostra o novo produto. 409: abre o modal da tela 09 (somar quantidade, cadastrar mesmo assim ou cancelar)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2C5D8A;strokeWidth=1.3;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="75" y="838" width="300" height="66" as="geometry"/></mxCell><mxCell id="n9" value="9" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#1C1F1E;strokeColor=#1C1F1E;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="62" y="825" width="26" height="26" as="geometry"/></mxCell><mxCell id="a9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;exitX=0;exitY=0.5;entryX=1;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>