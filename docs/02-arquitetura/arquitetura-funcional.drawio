<mxfile host="app.diagrams.net"><diagram id="p0" name="Arquitetura Funcional"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="KeepIT — Arquitetura Funcional (módulos do sistema)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="900" height="30" as="geometry"/></mxCell><mxCell id="bu" value="Usuários" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="160" height="40" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;ADMIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;titular da assinatura&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="62" width="210" height="50" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;EDITOR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;cadastra e edita produtos&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="62" width="210" height="50" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;LEITOR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;apenas consulta&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="62" width="210" height="50" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Visitante&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;sem login&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="62" width="210" height="50" as="geometry"/></mxCell><mxCell id="bi" value="Apresentação" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="160" height="40" as="geometry"/></mxCell><mxCell id="ui" value="Interface web responsiva — 24 telas (celular e desktop)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#1C1F1E;strokeColor=#1C1F1E;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="150" width="1360" height="40" as="geometry"/></mxCell><mxCell id="au0" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.1507;entryY=0;" edge="1" parent="1" source="a1" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="au1" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.3419;entryY=0;" edge="1" parent="1" source="a2" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="au2" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5331;entryY=0;" edge="1" parent="1" source="a3" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="au3" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.7243;entryY=0;" edge="1" parent="1" source="a4" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bm" value="Módulos de negócio" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="222" width="200" height="30" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b style=&quot;font-size:13px&quot;&gt;M1 · Autenticação e Conta&lt;/b&gt;&lt;br&gt;• Cadastro de usuário&lt;br&gt;• Login e encerrar sessão&lt;br&gt;• Recuperar senha (código por e-mail)&lt;br&gt;• Alterar senha&lt;br&gt;• Alterar dados cadastrais&lt;br&gt;• Excluir conta (dados apagados em até 24 h)&lt;br&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3EFEB;strokeColor=#0F5C4D;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="230" y="255" width="262" height="150" as="geometry"/></mxCell><mxCell id="um0" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.0963;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ui" target="m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m2" value="&lt;b style=&quot;font-size:13px&quot;&gt;M2 · Casa e Membros&lt;/b&gt;&lt;br&gt;• Criar Casa automática (plano Individual)&lt;br&gt;• Adicionar e remover membros&lt;br&gt;• Definir papel: ADMIN, EDITOR, LEITOR&lt;br&gt;• Aplicar limite de membros do plano&lt;br&gt;• Uma Casa por usuário por vez&lt;br&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3EFEB;strokeColor=#0F5C4D;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="504" y="255" width="262" height="150" as="geometry"/></mxCell><mxCell id="um1" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.2978;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ui" target="m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m3" value="&lt;b style=&quot;font-size:13px&quot;&gt;M3 · Produtos e Tags&lt;/b&gt;&lt;br&gt;• Cadastrar, editar e excluir produto&lt;br&gt;• Enviar fotos do produto&lt;br&gt;• Criar e aplicar tags&lt;br&gt;• Detectar produto duplicado&lt;br&gt;• Buscar e filtrar por nome ou tag&lt;br&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3EFEB;strokeColor=#0F5C4D;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="778" y="255" width="262" height="150" as="geometry"/></mxCell><mxCell id="um2" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.4993;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ui" target="m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m4" value="&lt;b style=&quot;font-size:13px&quot;&gt;M4 · Estatísticas&lt;/b&gt;&lt;br&gt;• Valor total do patrimônio&lt;br&gt;• Maior gasto e valor médio&lt;br&gt;• Valor por tag e tag mais comprada&lt;br&gt;• Produtos mais antigos&lt;br&gt;• Uso de armazenamento&lt;br&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3EFEB;strokeColor=#0F5C4D;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="1052" y="255" width="262" height="150" as="geometry"/></mxCell><mxCell id="um3" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.7007;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ui" target="m4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m5" value="&lt;b style=&quot;font-size:13px&quot;&gt;M5 · Planos e Assinatura&lt;/b&gt;&lt;br&gt;• Consultar planos&lt;br&gt;• Contratar plano (pagamento)&lt;br&gt;• Renovação mensal automática&lt;br&gt;• Cancelar (vale até a renovação)&lt;br&gt;• Expirar: Casa volta ao Individual&lt;br&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3EFEB;strokeColor=#0F5C4D;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="1326" y="255" width="262" height="150" as="geometry"/></mxCell><mxCell id="um4" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.9022;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ui" target="m5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bc" value="Serviços transversais" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="499" width="200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Notificações&lt;/b&gt;&lt;br&gt;Código de recuperação, aviso de&lt;br&gt;novo membro, renovação e expiração" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBF0DC;strokeColor=#C98A1B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="230.0" y="475" width="330.5" height="78" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Controle de acesso&lt;/b&gt;&lt;br&gt;Verifica o papel do usuário&lt;br&gt;em cada ação de cada módulo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBF0DC;strokeColor=#C98A1B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="572.5" y="475" width="330.5" height="78" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Arquivos e cota&lt;/b&gt;&lt;br&gt;Guarda as fotos e controla o&lt;br&gt;espaço usado pela Casa" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBF0DC;strokeColor=#C98A1B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="915.0" y="475" width="330.5" height="78" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:13px&quot;&gt;Rotinas agendadas&lt;/b&gt;&lt;br&gt;Expira assinaturas vencidas e&lt;br&gt;apaga contas excluídas (24 h)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBF0DC;strokeColor=#C98A1B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="1257.5" y="475" width="330.5" height="78" as="geometry"/></mxCell><mxCell id="x1" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.3964;entryY=0;" edge="1" parent="1" source="m1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x4" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.1891;entryY=0;" edge="1" parent="1" source="m2" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x2" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=-0.0182;entryY=0;" edge="1" parent="1" source="m3" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x3" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.6036;entryY=0;" edge="1" parent="1" source="m5" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="be" value="Sistemas externos" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="608" width="200" height="30" as="geometry"/></mxCell><mxCell id="e1" value="Serviço de E-mail" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250.0" y="600" width="290.5" height="46" as="geometry"/></mxCell><mxCell id="e2" value="Armazenamento de Imagens&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px&quot;&gt;(object storage em nuvem)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="935.0" y="600" width="290.5" height="46" as="geometry"/></mxCell><mxCell id="e3" value="Gateway de Pagamento" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1277.5" y="600" width="290.5" height="46" as="geometry"/></mxCell><mxCell id="y1" value="" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#6c8ebf;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y2" value="" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#6c8ebf;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y3" value="cobrança e&lt;br&gt;renovação" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#6c8ebf;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="m5" target="e3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1612" y="330"/><mxPoint x="1612" y="623"/></Array></mxGeometry></mxCell><mxCell id="nt" value="Setas cheias: uso entre camadas. Setas tracejadas: comunicação com sistemas externos (os mesmos do Diagrama de Contexto). Dependências entre módulos: M3 consulta M2 (papel e limite) e M5 (cota do plano); M4 lê os dados de M3; M2 consulta M5 (limite de membros)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="1500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>