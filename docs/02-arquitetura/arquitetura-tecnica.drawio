s e validação)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E1ECF6;strokeColor=#2C5D8A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="345" y="200" width="250" height="200" as="geometry"/></mxCell><mxCell id="z3" value="Render (hospedagem da API)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=#888888;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="520" height="520" as="geometry"/></mxCell><mxCell id="api" value="&lt;b style=&quot;font-size:13px&quot;&gt;API REST — Node.js + Express + TypeScript&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3EFEB;strokeColor=#0F5C4D;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="680" y="95" width="480" height="470" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;Rotas&lt;/b&gt; · /auth, /casas, /membros, /produtos, /tags,&lt;br&gt;/estatisticas, /planos, /assinaturas" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#0F5C4D;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="700" y="135" width="440" height="54" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;Middlewares&lt;/b&gt; · autenticação JWT · controle de acesso&lt;br&gt;por papel · validação com Zod · tratamento de erros" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#0F5C4D;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="700" y="205" width="440" height="54" as="geometry"/></mxCell><mxCell id="ll1" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;fontSize=10.5;labelBackgroundColor=#ffffff;" e