<mxfile host="app.diagrams.net"><diagram id="p0" name="Maquina de Estados Conta"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="KeepIT — Máquina de Estados: Conta do Usuário (notação UML)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="i0" value="" style="ellipse;aspect=fixed;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="187" width="26" height="26" as="geometry"/></mxCell><mxCell id="ATV" value="&lt;b&gt;ATIVA&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;entry / [sem Casa] criar Casa com o plano Individual&lt;br&gt;faça: usar o KeepIT conforme o papel na Casa&lt;/div&gt;" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="135" width="330" height="130" as="geometry"/></mxCell><mxCell id="EXS" value="&lt;b&gt;EXCLUSÃO SOLICITADA&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;entry / encerrar sessões;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[titular] cancelar assinatura;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[ADMIN] demais membros recebem Casa própria&lt;br&gt;faça: bloquear login até a rotina concluir&lt;/div&gt;" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="135" width="360" height="130" as="geometry"/></mxCell><mxCell id="f1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1180" y="187" width="30" height="30" as="geometry"/></mxCell><mxCell id="e1" value="cadastrar()&lt;br&gt;/ criar Casa Individual&lt;br&gt;(usuário é ADMIN)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="i0" target="ATV"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="solicitarExclusao()&lt;br&gt;[senha confirmada]&lt;br&gt;/ exclusaoSolicitadaEm = agora" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ATV" target="EXS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="rotina agendada&lt;br&gt;[até 24 h]&lt;br&gt;/ apagar dados pessoais" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="EXS" target="f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="removido da Casa ou Casa expirou&lt;br&gt;/ criar Casa própria com o plano Individual" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=0;entryX=0.85;entryY=0;" edge="1" parent="1" source="ATV" target="ATV"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="85"/><mxPoint x="470" y="85"/></Array></mxGeometry></mxCell><mxCell id="nt" value="&lt;b&gt;Regras:&lt;/b&gt; todo usuário sempre tem uma Casa (RF32). A exclusão é definitiva: os dados pessoais são apagados em até 24 h (RNF16), e os produtos que o usuário cadastrou continuam na Casa, sem o autor (adicionado_por fica nulo)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#c9b458;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="1240" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>