ne;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.339;entryX=1;entryY=0.6;" edge="1" parent="1" source="produto" target="tag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r9_m0" value="0..n" style="edgeLabel;resizable=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="r9"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset" y="-9"/></mxGeometry></mxCell><mxCell id="r9_m1" value="0..n" style="edgeLabel;resizable=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="r9"><mxGeometry x="0.72" relative="1" as="geometry"><mxPoint as="offset" y="-9"/></mxGeometry></mxCell><mxCell id="r10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;startSize=18;endSize=18;exitX=1;exitY=0.339;entryX=0;entryY=0.566;" edge="1" parent="1" source="produto" target="foto"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r10_m0" value="1" style="edgeLabel;resizable=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="r10"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset" y="-9"/></mxGeometry></mxCell><mxCell id="r10_m1" value="0..3" style="edgeLabel;resizable=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="r10"><mxGeometry x="0.72" relative="1" as="geometry"><mxPoint as="offset" y="-9"/></mxGeometry></mxCell><mxCell id="r11" value="adicionadoPor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0.5;entryY=1;" edge="1" parent="1" source="produto" target="usuario"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="796"/></Array></mxGeometry></mxCell><mxCell id="r11_m0" value="0..n" style="edgeLabel;resizable=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="r11"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset" y="-9"/></mxGeometry></mxCell><mxCell id="r11_m1" value="1" style="edgeLabel;resizable=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="r11"><mxGeometry x="0.72" relative="1" as="geometry"><mxPoint as="offset" y="-9"/></mxGeometry></mxCell><mxCell id="nota" value="&lt;b&gt;Regras representadas:&lt;/b&gt; cada usuário participa de exatamente uma Casa por vez (Membro 1 — 1 Usuario); quando sai ou é removido, o sistema cria para ele uma Casa própria com o plano Individual. O plano atual da Casa é o da assinatura ATIVA ou CANCELADA ainda vigente; sem assinatura vigente, a Casa está no plano Individual. Troca de plano gera uma nova Assinatura (histórico). Composição (◆): ao excluir a Casa, excluem-se membros, produtos e tags; ao excluir o Produto, excluem-se as fotos." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="1800" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>