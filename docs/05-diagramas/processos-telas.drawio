;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="s16" target="s13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="1050"/><mxPoint x="1560" y="1050"/><mxPoint x="1560" y="954"/></Array></mxGeometry></mxCell><mxCell id="g24" value="Minha assinatura (ADMIN)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F5C4D;strokeWidth=1.4;fontSize=10.5;labelBackgroundColor=#ffffff;fontColor=#0F5C4D;exitX=0.8;exitY=0;entryX=0.7;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="s16" target="s15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="1075"/><mxPoint x="1650" y="1075"/></Array></mxGeometry></mxCell><mxCell id="g25" value="membro" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F5C4D;strokeWidth=1.4;fontSize=10.5;labelBackgroundColor=#ffffff;fontColor=#0F5C4D;exitX=1;exitY=0.3;entryX=0;entryY=0.3;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="s13" target="s24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g26" value="continuar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F5C4D;strokeWidth=1.4;fontSize=10.5;labelBackgroundColor=#ffffff;fontColor=#0F5C4D;exitX=1;exitY=0.6;entryX=0;entryY=0.6;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="s24" target="s14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g27" value="Assinar (ADMIN)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F5C4D;strokeWidth=1.4;fontSize=10.5;labelBackgroundColor=#ffffff;fontColor=#0F5C4D;exitX=0.5;exitY=0;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="s13" target="s14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1630" y="750"/><mxPoint x="1950" y="750"/></Array></mxGeometry></mxCell><mxCell id="nt" value="&lt;b&gt;Como ler:&lt;/b&gt; cada miniatura é uma tela do protótipo; a seta mostra a ação que leva de uma tela à outra. Contorno laranja = modal (abre sobre a tela de origem). Na tela 13, quem assina sendo EDITOR ou LEITOR passa pelo aviso da tela 24; o ADMIN vai direto ao pagamento. A barra inferior (Início, Produtos, +, Família, Conta) está em todas as telas principais; as setas a partir da tela 05 representam essa navegação. &quot;Encerrar sessão&quot; (16) e &quot;Excluir conta&quot; (21) voltam para a tela 01." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="930" width="800" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>