eStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;fontSize=10.5;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="usuario" target="assin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="68"/><mxPoint x="540" y="68"/></Array></mxGeometry></mxCell><mxCell id="r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;fontSize=10.5;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4167;entryX=0;entryY=0.5882;" edge="1" parent="1" source="casa" target="membro"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERmandOne;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;fontSize=10.5;labelBackgroundColor=#ffffff;exitX=0;exitY=0.2564;entryX=1;entryY=0.4412;" edge="1" parent="1" source="usuario" target="membro"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;fontSize=10.5;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="casa" target="produto"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;fontSize=10.5;labelBackgroundColor=#ffffff;exitX=0.1923;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="casa" target="tag"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="470"/><mxPoint x="160" y="470"/></Array></mxGeometry></mxCell><mxCell id="r8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;fontSize=10.5;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4167;entryX=0;entryY=0.7895;" edge="1" parent="1" source="tag" target="ptag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;fontSize=10.5;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5556;entryX=1;entryY=0.5263;" edge="1" parent="1" source="produto" target="ptag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r10" value="0..3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;fontSize=10.5;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5556;entryX=0;entryY=0.4412;" edge="1" parent="1" source="produto" target="foto"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r11" value="adicionado_por" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;fontSize=10.5;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;entryX=1;entryY=0.3704;" edge="1" parent="1" source="usuario" target="produto"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="440"/><mxPoint x="1090" y="440"/><mxPoint x="1090" y="600.0"/></Array></mxGeometry></mxCell><mxCell id="r12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;fontSize=10.5;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="usuario" target="cod"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;fontSize=10.5;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;entryX=1;entryY=0.3061;" edge="1" parent="1" source="usuario" target="log"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1775" y="190"/><mxPoint x="1775" y="700"/></Array></mxGeometry></mxCell><mxCell id="lg" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;PK = chave primária (sublinhada) · FK = chave estrangeira · UK = valor único · &lt;i&gt;tipo?&lt;/i&gt; = aceita nulo&lt;br&gt;&lt;b&gt;‖&lt;/b&gt; exatamente um · &lt;b&gt;o|&lt;/b&gt; zero ou um · &lt;b&gt;o&amp;lt;&lt;/b&gt; zero ou muitos · &lt;b&gt;|&amp;lt;&lt;/b&gt; um ou muitos&lt;br&gt;Azul: domínio · Amarelo: comercial · Roxo: tabela associativa · Cinza: técnica (segurança e auditoria)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="1000" height="70" as="geometry"/></mxCell><mxCell id="rg" value="&lt;b&gt;Restrições principais&lt;/b&gt;&lt;br&gt;• membro.usuario_id é UNIQUE: cada usuário está em uma Casa por vez.&lt;br&gt;• tag: UNIQUE (casa_id, nome) · produto: índice em (casa_id, lower(nome)) para a busca e a verificação de duplicado.&lt;br&gt;• assinatura: no máximo uma ATIVA ou CANCELADA vigente por Casa (índice único parcial).&lt;br&gt;• produto.adicionado_por_id: ON DELETE SET NULL (o produto fica na Casa se o usuário excluir a conta).&lt;br&gt;• casa → membro, produto, tag, assinatura e produto → foto, produto_tag: ON DELETE CASCADE." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="30" y="880" width="1100" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>